IMAGE_TAG=1.0.0
# Alternative source when Docker Hub returns 403.
NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
BIND_IP=0.0.0.0
FRONTEND_PORT=3000
# Empty app URL uses the current browser origin.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_EXTERNAL_API_URL=/backend
NEXT_PUBLIC_INTERNAL_API_URL=http://backend:4000
NEXT_PUBLIC_CAPTCHA_KEY=0
NEXT_PUBLIC_SEPIDAR_SERVICE_CODE_IC=0
NEXT_PUBLIC_SEPIDAR_SERVICE_CODE_COI=0
NEXT_PUBLIC_SEPIDAR_SERVICE_CODE_SAMPLING=0
MONGO_ROOT_USERNAME=apk_root
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_DATABASE=apk
ELASTIC_PASSWORD=CHANGE_ME
ES_JAVA_OPTS="-Xms512m -Xmx512m"
